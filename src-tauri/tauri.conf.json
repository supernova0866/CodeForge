{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeForge",
  "version": "0.1.0",
  "identifier": "com.codeforge.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "beforeBuildCommand": "npm run build --prefix ../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodeForge",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://discord.com; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/codeforge/**", "$APPDATA/codeforge/CodeForge/ui/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "identifier": "com.codeforge.app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/YOUR_GH_USERNAME/codeforge/releases/latest/download/manifest.json"
      ],
      "dialog": true,
      "pubkey": "REPLACE_WITH_YOUR_GENERATED_PUBLIC_KEY"
    }
  }
}
